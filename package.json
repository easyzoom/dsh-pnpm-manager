{
  "name": "dsh-pnpm-manager",
  "version": "0.1.0",
  "description": "Manage pnpm proxy and registry settings for DeepSeek Harness (DSH): a host plugin with an auto-rendered settings form plus a standalone CLI.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-pnpm-manager": "bin/dsh-pnpm-manager.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "slots"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "bin",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "pnpm",
    "proxy",
    "registry"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/easyzoom/dsh-pnpm-manager.git"
  },
  "scripts": {
    "cli": "node bin/dsh-pnpm-manager.mjs",
    "test": "node --test test/npmrc.test.mjs test/plugin.test.mjs test/routes.test.mjs",
    "check": "node --check lib/index.js && node --check lib/npmrc.js && node --check bin/dsh-pnpm-manager.mjs"
  }
}
